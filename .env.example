# Optional; without CONTACT_WEBHOOK_URL the form opens an explicitly labelled email draft.
NEXT_PUBLIC_CONTACT_EMAIL=hello@altusmedialabs.com
NEXT_PUBLIC_BOOKING_URL=
# HTTPS endpoints that accept JSON and only return 2xx after durable acceptance.
CONTACT_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_URL=
# Optional server-only authentication token shared by both webhook endpoints.
FORM_WEBHOOK_TOKEN=
